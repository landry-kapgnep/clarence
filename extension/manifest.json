{
  "manifest_version": 3,
  "name": "Clarence — anonymiseur local",
  "version": "0.1.0",
  "description": "Anonymise les données sensibles avant de les coller dans ChatGPT, Claude ou Gemini. Tout reste dans votre navigateur.",
  "icons": {
    "16": "popup/img/ClarenceFairySimpleLogo.png",
    "48": "popup/img/ClarenceFairySimpleLogo.png",
    "128": "popup/img/ClarenceFairySimpleLogo.png"
  },
  "action": {
    "default_icon": {
      "16": "popup/img/ClarenceFairySimpleLogo.png",
      "48": "popup/img/ClarenceFairySimpleLogo.png",
      "128": "popup/img/ClarenceFairySimpleLogo.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "Clarence — préparer un texte"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content/content.js"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "Ouvrir Clarence"
    }
  },
  "permissions": ["clipboardWrite", "storage"],
  "web_accessible_resources": [
    {
      "resources": ["popup/*", "vendor/*"],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ]
    }
  ],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://cdn-lfs.huggingface.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
