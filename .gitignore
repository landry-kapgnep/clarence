node_modules/
*.log

# Modèles du banc d'essai (183 Mo, téléchargés à la demande)
tests/bench/.modeles/

# Sortie de build du site vitrine (prototype, régénérée par `npm run site`)
site/dist/

# Poids convertis de LLMLingua-2 (710 Mo en fp32 + 179 Mo en int8). Ils se
# régénèrent par `python tools/convertir-llmlingua2.py` et leur place est sur
# HuggingFace, pas dans un dépôt git — ce sont des artefacts de build.
tools/llmlingua2-onnx/
tools/.quant-essais/

# Corpus de non-régression : de VRAIS documents, souvent personnels.
# Règle absolue du projet — jamais de données réelles dans le dépôt, même
# anonymisées. Seuls les INSTANTANÉS sont committés, et ils ne contiennent que
# des empreintes des valeurs masquées, jamais les valeurs.
tests/regression/corpus/

# Miroir en clair des instantanés (empreinte → valeur réelle). Local seulement :
# il sert à NOMMER une valeur qui a cessé d'être masquée, ce que les empreintes
# ne peuvent pas dire. Le committer reviendrait à committer le corpus lui-même.
tests/regression/instantanes/*.clair.json

# Corpus synthétique généré : volumineux et reproductible en une commande
# (tools/corpus/generer.mjs). Le générateur est committé, sa sortie non.
*.jsonl

# Sorties de mesure : reproductibles par les scripts, jamais des sources.
# (Le harnais de régression tourne sur de VRAIS documents ; ses instantanés en
#  clair sont déjà exclus plus haut, mais mieux vaut deux barrières qu une.)
tools/filtre/*.txt

# Secrets. Aucun aujourd hui (le produit n a pas de backend), et cette ligne
# est là pour que ça reste vrai le jour où quelqu un en pose un par réflexe.
.env
.env.*
!.env.example
